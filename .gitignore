# 环境变量（含API密钥，绝对不能上传）
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 数据目录（运行时产物：向量库、日志、轨迹、笔记、对话记录）
data/

# 评测结果（运行时产物）
eval_results/

# 个人文件备份（学习记录、临时测试数据等，不属于项目）
_backup_personal/

# 临时调试脚本与日志（仅根目录，一次性排查用，不属于项目）
/_*.py
/_*.log
/_*.txt
# 兜底：上面的 /_*.py 会连 __init__.py 一起匹配，这里放行
!/__init__.py

# IDE
.idea/
.vscode/
*.swp
